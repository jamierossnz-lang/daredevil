SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Add your public domain here too once you expose the app (e.g.
# ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.x,daredevil.yourdomain.com) —
# Django rejects any request whose Host header isn't listed here with a bare
# 400, no matter how it reached the server.
ALLOWED_HOSTS=localhost,127.0.0.1

# Reverse proxy / HTTPS (Nginx Proxy Manager, Swag, Traefik, Cloudflare Tunnel, etc.)
# Add your domain so Django accepts CSRF tokens from it.
CSRF_TRUSTED_ORIGINS=https://daredevil.yourdomain.com

# Cloudflare Tunnel — exposes the app publicly with no port forwarding.
# Get this from the Zero Trust dashboard: Networks > Tunnels > Create a
# tunnel > Docker connector. Leave blank and comment out the `cloudflared`
# service in docker-compose.yml if you're not using this.
CLOUDFLARE_TUNNEL_TOKEN=

# LAN-only server (no tunnel): uncomment this instead of editing
# docker-compose.yml — it layers docker-compose.lan.yml on top, which leaves
# cloudflared out. Survives `git pull` because nothing tracked is changed.
# COMPOSE_FILE=docker-compose.yml:docker-compose.lan.yml

# Once HTTPS is actually terminated in front of the app (via the tunnel or a
# reverse proxy) flip both of these to True — this makes the login session
# and CSRF cookies HTTPS-only. Leave False for LAN-only HTTP access, since
# browsers will silently refuse to ever send a Secure cookie over plain HTTP.
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Optional "Sign in with Google" — only offered once both are set. See the
# comment in config/settings.py for linking it to your login.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# TMDB — https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# qBittorrent Web UI
# When running via Docker Compose, leave these as-is — the compose file overrides
# QBITTORRENT_HOST to the internal service name automatically.
# When connecting to a qBittorrent on another machine, set the IP/hostname here.
QBITTORRENT_HOST=qbittorrent
QBITTORRENT_PORT=8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# PostgreSQL password — used by Daredevil and by Sonarr, Radarr and Prowlarr,
# which keep their data in the same Postgres. Set it before the first start.
# DB_PASSWORD=change-me

# Redis (overridden by Docker Compose to use the internal redis service)
REDIS_URL=redis://localhost:6379/0

# ── Prowlarr / Sonarr / Radarr ─────────────────────────────────────────────
# Sonarr (TV) and Radarr (movies) store the library and do all the searching,
# downloading and importing; Prowlarr manages indexers for both. Configure
# them on Daredevil's App Settings page (Prowlarr / Sonarr / Radarr tabs) —
# that's stored in the database. Values here are optional and only seed it the
# first time the app starts. API keys: each app → Settings → General.
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
# FlareSolverr — gets Prowlarr past Cloudflare on the indexers you switch it on
# for (Settings → Prowlarr → FlareSolverr). The compose service by default;
# point it at your own FlareSolverr (e.g. an Unraid app) if you have one.
FLARESOLVERR_URL=http://flaresolverr:8191
# Address Sonarr/Radarr use to reach Daredevil for webhooks (grab/import
# events). The compose service name works when they share the Docker network.
DAREDEVIL_INTERNAL_URL=http://web:8000

# ── Docker-specific ────────────────────────────────────────────────────────
# User/group IDs for LinuxServer containers (run `id` on Linux to find yours)
# Unraid default: PUID=99 PGID=100  (nobody:users)
# macOS/Windows Docker Desktop: 1000 is fine
PUID=1000
PGID=1000

# Timezone — https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Pacific/Auckland

# ── Host paths (bind mounts) ───────────────────────────────────────────────
# All container config and app data lives under DATA_DIR.
# Media directories are mounted separately so they can point at your array.
# Unraid example:
#   DATA_DIR=/mnt/user/appdata/daredevil
#   DOWNLOADS_DIR=/mnt/user/Media/Downloads
#   MOVIES_DIR=/mnt/user/Media/Movies
#   TV_DIR=/mnt/user/Media/TV
DATA_DIR=./data
# Unraid only: lets Storage show the whole array and every pool, not just
# the pool your shares write to first (usually the cache). Mounted read-only.
#   UNRAID_STATUS_DIR=/var/local/emhttp
DOWNLOADS_DIR=./downloads
MOVIES_DIR=./movies
TV_DIR=./tv

# ── Port overrides ─────────────────────────────────────────────────────────
# Unraid WebUI runs on 8080 — change QBT_WEBUI_PORT to avoid the conflict.
APP_PORT=8000
QBT_WEBUI_PORT=8081
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878

# Plex claim token — get one at https://www.plex.tv/claim/ (expires in 4 minutes)
# Only needed on first run. Remove or leave blank after Plex is set up.
PLEX_CLAIM=

# ── Plex API ───────────────────────────────────────────────────────────────────
# URL of your Plex server. The compose file runs Plex with host networking, so
# use the server's LAN address (e.g. http://192.168.1.10:32400), or
# http://host.docker.internal:32400 on Docker Desktop.
PLEX_URL=http://localhost:32400
# Your Plex token — find it at: Plex Web → Account → Authorized Devices → (any device) → token
PLEX_TOKEN=
# Library section names (must match exactly what you named them in Plex)
PLEX_MOVIE_SECTION=Movies
PLEX_TV_SECTION=TV Shows

# ── ntfy push notifications ────────────────────────────────────────────────────
# Install the ntfy app (iOS/Android) or use the web UI at ntfy.sh.
# Pick a unique topic name — anyone who knows it can subscribe, so use something unguessable.
# Self-host ntfy (Docker) for private use; set NTFY_URL to your server and NTFY_TOKEN for auth.
# NTFY_TOPIC: e.g. daredevil-abc123 — leave blank to disable.
# NTFY_TOKEN: optional Bearer token for private/authenticated topics.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
